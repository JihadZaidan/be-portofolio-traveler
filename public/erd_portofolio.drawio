<mxfile host="app.diagrams.net">
  <diagram name="ERD Portfolio Service" id="erd1">
    <mxGraphModel dx="1420" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- USERS -->
        <mxCell id="users" value="USERS&#xa;────────────&#xa;PK user_id&#xa;name&#xa;email&#xa;password&#xa;phone&#xa;role&#xa;created_at" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- ADMINS -->
        <mxCell id="admins" value="ADMINS&#xa;────────────&#xa;PK admin_id&#xa;name&#xa;email&#xa;password&#xa;created_at" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- PORTFOLIO -->
        <mxCell id="portfolio" value="PORTFOLIO&#xa;────────────&#xa;PK portfolio_id&#xa;title&#xa;description&#xa;image_url&#xa;category&#xa;created_at&#xa;FK created_by" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="40" width="240" height="190" as="geometry"/>
        </mxCell>

        <!-- ARTICLES -->
        <mxCell id="articles" value="ARTICLES&#xa;────────────&#xa;PK article_id&#xa;title&#xa;content&#xa;thumbnail&#xa;created_at&#xa;FK created_by" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="260" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- SERVICES -->
        <mxCell id="services" value="SERVICES&#xa;────────────&#xa;PK service_id&#xa;name&#xa;description&#xa;price&#xa;duration_estimate&#xa;is_active&#xa;FK created_by" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="470" width="240" height="190" as="geometry"/>
        </mxCell>

        <!-- ORDERS -->
        <mxCell id="orders" value="ORDERS&#xa;────────────&#xa;PK order_id&#xa;FK user_id&#xa;order_date&#xa;status&#xa;total_price&#xa;notes" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="230" height="170" as="geometry"/>
        </mxCell>

        <!-- ORDER DETAILS -->
        <mxCell id="order_details" value="ORDER_DETAILS&#xa;────────────&#xa;PK order_detail_id&#xa;FK order_id&#xa;FK service_id&#xa;price&#xa;qty&#xa;subtotal" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="230" height="170" as="geometry"/>
        </mxCell>

        <!-- PAYMENTS -->
        <mxCell id="payments" value="PAYMENTS&#xa;────────────&#xa;PK payment_id&#xa;FK order_id&#xa;payment_method&#xa;payment_status&#xa;amount&#xa;transaction_id&#xa;paid_at&#xa;created_at" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="490" width="230" height="190" as="geometry"/>
        </mxCell>

        <!-- CHAT SESSIONS -->
        <mxCell id="chat_sessions" value="CHAT_SESSIONS&#xa;────────────&#xa;PK chat_session_id&#xa;FK user_id&#xa;started_at&#xa;ended_at" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="80" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- CHAT MESSAGES -->
        <mxCell id="chat_messages" value="CHAT_MESSAGES&#xa;────────────&#xa;PK message_id&#xa;FK chat_session_id&#xa;sender&#xa;message_text&#xa;created_at" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="280" width="230" height="170" as="geometry"/>
        </mxCell>

        <!-- RELATIONSHIPS -->
        <mxCell id="r1" style="endArrow=block;" edge="1" parent="1" source="users" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="endArrow=block;" edge="1" parent="1" source="orders" target="order_details"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" style="endArrow=block;" edge="1" parent="1" source="services" target="order_details"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" style="endArrow=block;" edge="1" parent="1" source="orders" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r5" style="endArrow=block;" edge="1" parent="1" source="users" target="chat_sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r6" style="endArrow=block;" edge="1" parent="1" source="chat_sessions" target="chat_messages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r7" style="endArrow=block;" edge="1" parent="1" source="admins" target="portfolio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r8" style="endArrow=block;" edge="1" parent="1" source="admins" target="articles"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r9" style="endArrow=block;" edge="1" parent="1" source="admins" target="services"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
